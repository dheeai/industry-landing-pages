---
import '../styles/studio-tokens.css';
import '../styles/studio-system.css';
import StudioHeader from '../components/StudioHeader.astro';
import StudioFooter from '../components/StudioFooter.astro';
import FloatingChrome from '../components/FloatingChrome.astro';
import type { LandingPage as PageData } from '../content/schema';
import { resolveThemeStyle } from '../content/schema';

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const publicAsset = (path: string) => (path.startsWith('http') ? path : `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`);
const privacyUrl = import.meta.env.PUBLIC_PRIVACY_URL;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const analyticsEnabled = Boolean(privacyUrl && plausibleDomain);

const nav = page.navigation ?? { response: 'First response', applications: 'Applications', journey: 'How it works', sample: 'Sample' };
const navItems = [
  { label: nav.response, href: '#first-response' },
  { label: nav.applications, href: '#applications' },
  { label: nav.journey, href: '#journey' },
  ...(page.studio && nav.studio ? [{ label: nav.studio, href: '#dhee' }] : []),
  { label: nav.sample, href: '#sample' }
];

const railItems = [
  { id: 'top', label: 'Hero' },
  { id: 'bridge', label: 'Bridge' },
  ...(page.trigger || page.metrics ? [{ id: 'why', label: 'Why now' }] : []),
  { id: 'first-response', label: nav.response },
  { id: 'applications', label: nav.applications },
  { id: 'journey', label: nav.journey },
  { id: 'library', label: 'Library' },
  { id: 'process', label: 'Process' },
  { id: 'faq', label: 'FAQ' }
];

const canonicalUrl = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${page.slug}/`, Astro.site).toString();
const shareImage = page.hero.image?.startsWith('http')
  ? page.hero.image
  : new URL(publicAsset(page.hero.image ?? '/images/industrial-machine-hero.jpg'), Astro.site).toString();
const themeStyle = resolveThemeStyle(page);
---
<!doctype html>
<html lang={page.language} data-page-slug={page.slug} data-page-type={page.pageType} style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.seo.description} />
    {page.seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.seo.title} />
    <meta property="og:description" content={page.seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.seo.title} />
    <meta name="twitter:description" content={page.seo.description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="theme-color" content="#030508" />
    <title>{page.seo.title}</title>
    <link rel="icon" type="image/png" href={publicAsset('/images/dhee-mark-black.png')} />
    <link rel="apple-touch-icon" href={publicAsset('/images/dhee-mark-black.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <StudioHeader page={page} navItems={navItems} />
    <main id="main"><slot /></main>
    <StudioFooter page={page} privacyUrl={privacyUrl} analyticsEnabled={analyticsEnabled} />
    <FloatingChrome page={page} railItems={railItems} />

    {analyticsEnabled && (
      <>
        <div class="analytics-consent" data-analytics-consent hidden role="dialog" aria-modal="false" aria-labelledby="analytics-consent-title">
          <div>
            <strong id="analytics-consent-title">{page.ui?.analyticsTitle ?? 'Help us understand this page'}</strong>
            <p>
              {page.ui?.analyticsBody ?? 'Optional analytics measure page use and video engagement.'}{' '}
              <a href={privacyUrl} target="_blank" rel="noreferrer">{page.ui?.privacyLabel ?? 'Privacy'}</a>.
            </p>
          </div>
          <div class="analytics-consent-actions">
            <button type="button" data-consent-reject>{page.ui?.rejectLabel ?? 'Reject'}</button>
            <button type="button" data-consent-accept>{page.ui?.acceptLabel ?? 'Accept analytics'}</button>
          </div>
        </div>
        <div data-analytics-config data-domain={plausibleDomain} hidden></div>
        <script is:inline>
          (() => {
            const key = 'dhee-analytics-consent';
            const banner = document.querySelector('[data-analytics-consent]');
            const config = document.querySelector('[data-analytics-config]');
            let loaded = false;
            const loadAnalytics = () => {
              if (loaded || !config?.dataset.domain) return;
              loaded = true;
              const script = document.createElement('script');
              script.defer = true;
              script.src = 'https://plausible.io/js/script.js';
              script.dataset.domain = config.dataset.domain;
              document.head.append(script);
            };
            const campaignProps = () => {
              const params = new URLSearchParams(window.location.search);
              const props = {
                page_slug: document.documentElement.dataset.pageSlug || 'unknown',
                language: document.documentElement.lang || 'unknown'
              };
              ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((name) => {
                const value = params.get(name);
                if (value) props[name] = value.slice(0, 120);
              });
              return props;
            };
            const track = (event, props = {}) => {
              if (localStorage.getItem(key) === 'accepted') window.plausible?.(event, { props: { ...campaignProps(), ...props } });
            };
            const showBanner = () => { if (banner) banner.hidden = false; };
            const closeBanner = () => { if (banner) banner.hidden = true; };
            const consent = localStorage.getItem(key);
            if (consent === 'accepted') loadAnalytics();
            else if (consent !== 'rejected') showBanner();
            document.querySelector('[data-consent-accept]')?.addEventListener('click', () => {
              localStorage.setItem(key, 'accepted'); closeBanner(); loadAnalytics();
            });
            document.querySelector('[data-consent-reject]')?.addEventListener('click', () => {
              localStorage.setItem(key, 'rejected'); closeBanner();
            });
            document.querySelector('[data-analytics-settings]')?.addEventListener('click', showBanner);
            document.querySelectorAll('[data-analytics]').forEach((element) =>
              element.addEventListener('click', () =>
                track(element.dataset.analytics, element.dataset.language ? { target_language: element.dataset.language } : {})
              )
            );
            const seenDepths = new Set();
            const watchScroll = () => {
              const max = document.documentElement.scrollHeight - window.innerHeight;
              if (max <= 0) return;
              const depth = Math.floor((window.scrollY / max) * 100);
              [25, 50, 75, 100].forEach((threshold) => {
                if (depth >= threshold && !seenDepths.has(threshold)) {
                  seenDepths.add(threshold);
                  track('scroll_depth', { percent: threshold });
                }
              });
            };
            window.addEventListener('scroll', watchScroll, { passive: true });
            document.querySelectorAll('video').forEach((video) => {
              const seen = new Set();
              video.addEventListener('play', () => track('video_play'));
              video.addEventListener('timeupdate', () => {
                if (!video.duration) return;
                const percent = Math.floor((video.currentTime / video.duration) * 100);
                [25, 50, 100].forEach((threshold) => {
                  if (percent >= threshold && !seen.has(threshold)) {
                    seen.add(threshold);
                    track('video_watch', { percent: threshold });
                  }
                });
              });
            });
          })();
        </script>
      </>
    )}

    <script>
      import { initStudioMotion } from '../scripts/studio-motion';
      initStudioMotion();
    </script>
  </body>
</html>
