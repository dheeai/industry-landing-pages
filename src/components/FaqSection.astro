---
import type { LandingPage } from '../content/schema';

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
---
<section class="band-stone" id="faq" data-section-tone="light">
  <div class="shell faq-layout">
    <div data-reveal>
      <p class="eyebrow"><span class="eyebrow-dot"></span>{page.faqTitle?.eyebrow ?? 'Good questions, straight answers'}</p>
      <h2 class="section-title">
        {page.faqTitle?.title ?? 'Before we make'}<br />
        <em>{page.faqTitle?.emphasis ?? 'the first frame.'}</em>
      </h2>
    </div>

    <div class="faq-list" data-reveal>
      {page.faqs.map((faq) => (
        <details class="faq-item">
          <summary>
            <span>{faq.question}</span>
            <span class="faq-plus" aria-hidden="true">＋</span>
          </summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
