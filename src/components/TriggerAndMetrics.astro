---
import type { LandingPage } from '../content/schema';

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
const ext = (href: string) => (href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {});
---
{(page.trigger || page.metrics) && (
  <section class="band-dark" id="why" data-section-tone="dark">
    <div class="shell">
      {page.trigger && (
        <div class="trigger-shell glass-specular" data-spotlight data-reveal>
          <div class="trigger-stamp-box">
            <span class="eyebrow"><span class="eyebrow-dot"></span>{page.trigger.eyebrow}</span>
            <strong class="trigger-stamp">{page.trigger.dateStamp}</strong>
            <span class="trigger-label">{page.trigger.dateLabel}</span>
          </div>
          <div class="trigger-copy">
            <h2>{page.trigger.title}</h2>
            <p>{page.trigger.body}</p>
            <a class="link-arrow" href={page.trigger.source.href} {...ext(page.trigger.source.href)}>
              {page.trigger.source.label} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      )}

      {page.metrics && (
        <div style={page.trigger ? 'margin-top: 48px;' : undefined} data-reveal>
          <div class="section-head">
            <div>
              <p class="eyebrow"><span class="eyebrow-dot"></span>{page.metrics.eyebrow}</p>
              <h2 class="section-title">{page.metrics.title}</h2>
            </div>
            <div>
              <p class="section-lead">{page.metrics.body}</p>
              <a class="link-arrow" style="margin-top: 14px;" href={page.metrics.source.href} {...ext(page.metrics.source.href)}>
                {page.metrics.source.label} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="metrics-grid">
            {page.metrics.items.map((item) => (
              <article class="metric-card" data-tilt>
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </article>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
)}
