---
import LandingPage from '../layouts/LandingPage.astro';
import type { LandingPage as PageData } from '../content/schema';
import { validateLandingPage } from '../content/schema';
export function getStaticPaths() {
  const pageModules = import.meta.glob('../content/pages/*.json', { eager: true, import: 'default' });
  const pages = Object.values(pageModules) as PageData[];
  for (const page of pages) validateLandingPage(page);
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: PageData };
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {};
const publicAsset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<LandingPage page={page}>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{page.hero.eyebrow}</p>
      <h1>{page.hero.title}<br /><em>{page.hero.emphasis}</em></h1>
      <p class="hero-body">{page.hero.body}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={page.hero.primary.href}>{page.hero.primary.label}<span aria-hidden="true">↗</span></a>
        <a class="text-link" href={page.hero.secondary.href}>{page.hero.secondary.label}<span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-note"><span class="note-icon">✳</span><span>One clear story.<br /><strong>More confident decisions.</strong></span></div>
    </div>
    <div class="hero-art" aria-label="Illustration of a modular industrial machine and its workflow">
      <div class="art-grid" aria-hidden="true"></div>
      <div class="art-label art-label-top"><span>FIELD NOTE / 01</span><span>PRODUCT STORY</span></div>
      <img src={publicAsset('/images/machinery-concept.svg')} alt="Illustrated concept of a modular industrial machine and its workflow" fetchpriority="high" />
      <div class="art-orbit art-orbit-one" aria-hidden="true"></div><div class="art-orbit art-orbit-two" aria-hidden="true"></div>
      <div class="art-callout art-callout-in"><span>01 / INPUT</span><strong>One part enters</strong></div>
      <div class="art-callout art-callout-out"><span>03 / OUTPUT</span><strong>Clear result</strong></div>
      <div class="art-stamp"><span>BUILT FOR</span><strong>REAL<br />WORK</strong><span>EUROPE / 2027</span></div>
      <div class="art-caption"><span class="pulse"></span>MAKE THE COMPLEX, CLEAR</div>
    </div>
  </section>

  {page.trigger && <section class="trigger-band" id="why"><div class="wrap trigger-grid">
    <div class="trigger-date"><span class="eyebrow">{page.trigger.eyebrow}</span><strong>20<span> / </span>01</strong><span class="trigger-year">2027 · EU MACHINERY REGULATION</span></div>
    <div class="trigger-copy"><h2>{page.trigger.title}</h2><p>{page.trigger.body}</p><a class="light-link" href={page.trigger.source.href} {...ext(page.trigger.source.href)}>{page.trigger.source.label}<span aria-hidden="true">↗</span></a></div>
  </div></section>}

  <section class="concept-section wrap" id="concept">
    <div class="section-intro"><p class="eyebrow">A better product conversation</p><h2>{page.concept.title}</h2></div>
    <div class="concept-content"><div class="concept-steps">{page.concept.steps.map((step, i) => <div class="concept-step"><span>0{i + 1}</span><p>{step}</p><i aria-hidden="true">↗</i></div>)}</div><p class="body-large">{page.concept.body}</p></div>
  </section>

  <section class="journey-section" id="journey" data-story-step="0">
    <div class="wrap journey-layout">
      <div class="journey-intro"><p class="eyebrow"><span class="eyebrow-dot"></span>One machine, one useful story</p><h2>Follow the part.<br /><em>Understand the process.</em></h2><p>A short explainer gives a customer a clear thread to follow: what goes in, what happens inside, and what comes out. That makes a complex machine easier to discuss.</p><div class="journey-controls" role="tablist" aria-label="Follow the workpiece through the machine">
        <button class="journey-tab is-active" type="button" role="tab" aria-selected="true" data-story-tab="0"><span>01</span> The input</button>
        <button class="journey-tab" type="button" role="tab" aria-selected="false" data-story-tab="1"><span>02</span> The process</button>
        <button class="journey-tab" type="button" role="tab" aria-selected="false" data-story-tab="2"><span>03</span> The outcome</button>
      </div></div>
      <div class="journey-visual" aria-live="polite">
        <div class="journey-topline"><span>THE CUSTOMER'S VIEW</span><span class="journey-counter">01 / 03</span></div>
        <div class="journey-machine"><span class="machine-zone zone-one">IN</span><span class="machine-zone zone-two">PROCESS</span><span class="machine-zone zone-three">OUT</span><span class="workpiece"></span><span class="workpiece-trail"></span></div>
        <div class="journey-caption"><span class="journey-caption-index">01</span><div><h3 data-story-title>Start with one part.</h3><p data-story-copy>Show the product entering the line, so the viewer has a familiar point to follow.</p></div><span class="journey-next" aria-hidden="true">↗</span></div>
      </div>
    </div>
  </section>

  <section class="usecases" id="applications"><div class="wrap">
    <div class="usecase-heading"><div><p class="eyebrow">Where a clear story helps</p><h2>Useful across<br /><em>the whole journey.</em></h2></div><p>One machine can raise different questions at every stage. Give each moment its own focused explanation.</p></div>
    <div class="usecase-list">{page.useCases.map((item) => <article class="usecase-row"><span class="usecase-number">{item.number}</span><div class="usecase-title"><span class="tag">{item.tag}</span><h3>{item.title}</h3></div><p>{item.body}</p><span class="row-arrow" aria-hidden="true">↗</span></article>)}</div>
  </div></section>

  <section class="sample-section wrap" id="sample">
    <div class="sample-heading"><div><p class="eyebrow">A short-form product story</p><h2>{page.video.title}</h2></div><p>{page.video.description}</p></div>
    <div class:list={['sample-frame', page.video.videoUrl ? 'has-video' : 'concept-mode']}>
      {page.video.videoUrl ? <video controls preload="none" poster={publicAsset(page.video.poster)} aria-label={page.video.title}>
        <source src={publicAsset(page.video.videoUrl)} />
        {page.video.captionsUrl && <track kind="captions" src={publicAsset(page.video.captionsUrl)} srclang={page.language} label={`${page.language.toUpperCase()} captions`} default />}
        Your browser does not support embedded video. Read the storyboard transcript below.
      </video> : <img src={publicAsset(page.video.poster)} alt="Concept poster: an industrial machine in a clean factory bay, with its workflow highlighted" loading="lazy" />}
      {!page.video.videoUrl && <>
        <div class="sample-topline"><span>{page.video.label}</span><span>DHEE / MOTION STUDY</span></div>
        <div class="sample-center"><span class="play-mark" aria-hidden="true">24</span><span>SECOND STORYBOARD</span></div>
        <div class="sample-bottom"><span>FROM PRODUCT DETAIL TO BIG PICTURE</span><span>{page.video.duration}</span></div>
      </>}
    </div>
    <details class="transcript"><summary>Read the sample storyboard</summary><ol>{page.video.transcript.map((line) => <li>{line}</li>)}</ol></details>
  </section>

  <section class="library-section"><div class="wrap library-layout"><div class="library-intro"><p class="eyebrow">A growing product library</p><h2>{page.library.title}</h2><p>{page.library.body}</p><a class="text-link" href="#contact">Plan your first story <span aria-hidden="true">→</span></a></div><div class="library-items">{page.library.items.map((item) => <article><span>{item.number}</span><div><h3>{item.title}</h3><p>{item.detail}</p></div><span class="library-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>

  <section class="process-section wrap"><div class="process-heading"><p class="eyebrow">From product to page</p><h2>{page.process.title}</h2></div><div class="process-steps">{page.process.steps.map((step, i) => <article><span class="process-number">{step.number}</span><span class="process-line"></span><h3>{step.title}</h3></article>)}</div></section>

  <section class="faq-section wrap"><div class="faq-intro"><p class="eyebrow">Good questions, straight answers</p><h2>Before we make<br /><em>the first frame.</em></h2></div><div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">＋</span></summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="final-cta" id="contact"><div class="wrap cta-inner"><div class="cta-kicker">DHEE / INDUSTRY STORIES <span>—</span> 001</div><h2>{page.cta.title}</h2><p>{page.cta.body}</p><div class="hero-actions"><a class="button button-light" href={page.cta.primary.href} {...ext(page.cta.primary.href)}>{page.cta.primary.label}<span aria-hidden="true">↗</span></a><a class="cta-email" href={page.cta.email.href}>{page.cta.email.label}</a></div><span class="cta-orbit" aria-hidden="true">D</span></div></section>
  <script>
    const stories = [
      { title: 'Start with one part.', copy: 'Show the product entering the line, so the viewer has a familiar point to follow.' },
      { title: 'Make the middle visible.', copy: 'Reveal the sequence inside the machine and explain the transformation in plain language.' },
      { title: 'Finish with the result.', copy: 'Show what comes out and give the customer a clearer next question for your team.' },
    ];
    const journey = document.querySelector<HTMLElement>('.journey-section');
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-story-tab]')];
    const title = document.querySelector<HTMLElement>('[data-story-title]');
    const copy = document.querySelector<HTMLElement>('[data-story-copy]');
    const counter = document.querySelector<HTMLElement>('.journey-counter');
    const index = document.querySelector<HTMLElement>('.journey-caption-index');
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const step = Number(tab.dataset.storyTab);
      journey?.setAttribute('data-story-step', String(step));
      tabs.forEach((item, itemIndex) => {
        const active = itemIndex === step;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      if (title) title.textContent = stories[step].title;
      if (copy) copy.textContent = stories[step].copy;
      if (counter) counter.textContent = `0${step + 1} / 03`;
      if (index) index.textContent = `0${step + 1}`;
    }));
    const revealItems = document.querySelectorAll<HTMLElement>('.hero-copy, .hero-art, .concept-section, .journey-layout, .usecase-row, .sample-heading, .sample-frame, .library-layout, .process-steps, .faq-section, .final-cta .cta-inner');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealItems.forEach((item) => item.classList.add('motion-ready'));
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }), { threshold: 0.14 });
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</LandingPage>
