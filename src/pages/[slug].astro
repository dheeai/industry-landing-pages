---
import LandingPage from '../layouts/LandingPage.astro';
import type { LandingPage as PageData } from '../content/schema';
import { validateLandingPage } from '../content/schema';
export function getStaticPaths() {
  const pageModules = import.meta.glob('../content/pages/*.json', { eager: true, import: 'default' });
  const pages = Object.values(pageModules) as PageData[];
  for (const page of pages) validateLandingPage(page);
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: PageData };
const ext = (href: string) => href.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {};
const publicAsset = (path: string) => path.startsWith('http') ? path : `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
---
<LandingPage page={page}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{page.hero.eyebrow}<span class="hero-edition">DHEE / INDUSTRY STORIES {page.hero.edition ?? '001'}</span></p>
      <h1>{page.hero.title}<br /><em>{page.hero.emphasis}</em></h1>
      <p class="hero-body">{page.hero.body}</p>
      <div class="hero-actions">
        <a class="button button-dark" href={page.hero.primary.href}>{page.hero.primary.label}<span aria-hidden="true">↗</span></a>
        <a class="text-link" href={page.hero.secondary.href}>{page.hero.secondary.label}<span aria-hidden="true">→</span></a>
      </div>
      <div class="hero-note"><span class="note-icon">✳</span><span>{page.hero.note ?? 'One clear story.'}<br /><strong>{page.hero.noteEmphasis ?? 'More confident decisions.'}</strong></span></div>
      <div class="hero-research"><strong>{page.research.value}</strong><span>{page.research.body}<a href={page.research.source.href} target="_blank" rel="noreferrer">{page.research.source.label} ↗</a></span></div>
    </div>
      <div class="hero-art" aria-label={page.hero.imageAlt ?? 'Illustration of a product and its workflow'}>
      <div class="art-grid" aria-hidden="true"></div>
        <div class="art-label art-label-top"><span>{page.hero.artTopLabel ?? 'FIELD NOTE / 01'}</span><span>PRODUCT STORY</span></div>
        <img src={publicAsset(page.hero.image ?? '/images/industrial-machine-hero.jpg')} alt={page.hero.imageAlt ?? 'Fictional modular production machine in a bright workshop'} fetchpriority="high" />
      <div class="art-orbit art-orbit-one" aria-hidden="true"></div><div class="art-orbit art-orbit-two" aria-hidden="true"></div>
        <div class="art-callout art-callout-in"><span>01 / INPUT</span><strong>{page.hero.artInput ?? 'One part enters'}</strong></div>
        <div class="art-callout art-callout-out"><span>03 / OUTPUT</span><strong>{page.hero.artOutput ?? 'Clear result'}</strong></div>
        <div class="art-stamp"><span>{page.hero.artStampTop ?? 'BUILT FOR'}</span><strong>{page.hero.artStamp ?? <>REAL<br />WORK</>}</strong><span>{page.hero.artStampLabel ?? 'MACHINERY / 01'}</span></div>
      <div class="art-caption"><span class="pulse"></span>MAKE THE COMPLEX, CLEAR</div>
    </div>
  </section>

  <section class="sample-section wrap" id="sample">
    <div class="sample-heading"><div><p class="eyebrow">A short-form product story</p><h2>{page.video.title}</h2></div><p>{page.video.description}</p></div>
    <div class:list={['sample-frame', page.video.videoUrl ? 'has-video' : 'concept-mode']}>
      {page.video.videoUrl ? <video
        controls={!page.video.autoplayOnScroll}
        loop={page.video.autoplayOnScroll}
        playsinline
        preload="metadata"
        poster={publicAsset(page.video.poster)}
        aria-label={page.video.title}
        data-scroll-autoplay={page.video.autoplayOnScroll ? '' : undefined}
      >
        <source src={publicAsset(page.video.videoUrl)} />
        {page.video.captionsUrl && <track kind="captions" src={publicAsset(page.video.captionsUrl)} srclang={page.language} label={`${page.language.toUpperCase()} captions`} default />}
        Your browser does not support embedded video.
      </video> : <img src={publicAsset(page.video.poster)} alt="Concept poster: an industrial machine in a clean factory bay, with its workflow highlighted" loading="lazy" />}
      {page.video.videoUrl && page.video.autoplayOnScroll && <button class="video-sound-start" type="button" hidden aria-label={`Play ${page.video.title} with sound`}>
        <span aria-hidden="true">▶</span> Play with sound
      </button>}
      {!page.video.videoUrl && <>
        <div class="sample-topline"><span>{page.video.label}</span><span>DHEE / MOTION STUDY</span></div>
        <div class="sample-center"><span class="play-mark" aria-hidden="true">▶</span><span>60-SECOND STORYBOARD</span></div>
        <div class="sample-bottom"><span>FROM PRODUCT DETAIL TO BIG PICTURE</span><span>{page.video.duration}</span></div>
      </>}
    </div>
  </section>

  <section class="principle-band" aria-label="How a product story helps">
    <div class="wrap principle-top"><span>DHEE / THE BRIDGE</span><span>{page.concept.steps.map((step, i) => <>{i > 0 && <i>→</i>}{step.toUpperCase()}</>)}</span></div>
    <div class="wrap principle-copy"><p>{page.concept.eyebrow}</p><h2>{page.concept.title}</h2><p class="principle-body">{page.concept.body}</p><span class="principle-orbit" aria-hidden="true">↗</span></div>
    <div class="wrap principle-bottom"><span>01 / {page.concept.steps[0]?.toUpperCase()}</span><span>02 / {page.concept.steps[1]?.toUpperCase()}</span><span>03 / {page.concept.steps[2]?.toUpperCase()}</span></div>
  </section>

  {page.trigger && <section class="trigger-band" id="why"><div class="wrap trigger-grid">
    <div class="trigger-date"><span class="eyebrow">{page.trigger.eyebrow}</span><strong>{page.trigger.dateStamp}</strong><span class="trigger-year">{page.trigger.dateLabel}</span></div>
    <div class="trigger-copy"><h2>{page.trigger.title}</h2><p>{page.trigger.body}</p><a class="light-link" href={page.trigger.source.href} {...ext(page.trigger.source.href)}>{page.trigger.source.label}<span aria-hidden="true">↗</span></a></div>
  </div></section>}

  {page.metrics && <section class="metrics-band"><div class="wrap metrics-layout">
    <div class="metrics-intro"><p class="eyebrow">{page.metrics.eyebrow}</p><h2>{page.metrics.title}</h2><p>{page.metrics.body}</p><a href={page.metrics.source.href} {...ext(page.metrics.source.href)}>{page.metrics.source.label}<span aria-hidden="true"> ↗</span></a></div>
    <div class="metrics-grid">{page.metrics.items.map((item) => <article class="metric-card"><strong>{item.value}</strong><span>{item.label}</span></article>)}</div>
  </div></section>}

  <section class="reply-section" id="first-response" data-reply-step="0">
    <div class="wrap reply-layout">
      <div class="reply-intro">
        <p class="eyebrow"><span class="eyebrow-dot"></span>{page.response.eyebrow}</p>
        <h2>{page.response.title}</h2>
        <p>{page.response.body}</p>
        <div class="reply-options" role="tablist" aria-label="Choose a sample buyer question">
          {page.response.tabs.map((item, i) => <button class:list={['reply-tab', i === 0 && 'is-active']} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-reply-tab={i} data-reply-question={item.question} data-reply-answer={item.answer} data-reply-asset={item.asset}><span>0{i + 1}</span> {item.label}</button>)}
        </div>
      </div>
      <div class="reply-demo" aria-live="polite">
        <div class="reply-window-top"><span><i></i> EXAMPLE CONVERSATION</span><span>PRODUCT EDUCATION / 01</span></div>
        <div class="reply-chat">
          <div class="reply-before"><span>{page.response.beforeLabel}</span><p>“{page.response.beforeMessage}”</p><small>{page.response.beforeNote}</small></div>
          <div class="reply-before-arrow">INSTEAD <span aria-hidden="true">↓</span></div>
          <div class="chat-label">PROSPECT <span>EXAMPLE QUESTION</span></div>
          <p class="chat-bubble chat-question" data-reply-question>{page.response.tabs[0]?.question}</p>
          <div class="chat-label chat-label-company">MANUFACTURER <span>HELPFUL FIRST RESPONSE</span></div>
          <p class="chat-bubble chat-answer" data-reply-answer>{page.response.tabs[0]?.answer}</p>
          <div class="reply-asset"><span class="reply-play" aria-hidden="true">▶</span><div><strong data-reply-asset>{page.response.tabs[0]?.asset}</strong><small>{page.response.assetLabel ?? 'PRODUCT EXPLAINER · SAMPLE IDEA'}</small></div><span class="reply-duration">{page.response.videoDuration ?? '00:45'}</span></div>
        </div>
        <div class="reply-foot"><span><b>01</b> ANSWER THE QUESTION VISUALLY</span><span>02 <i>→</i> CONTINUE WITH AN EXPERT</span></div>
      </div>
    </div>
  </section>

  <section class="usecases" id="applications"><div class="wrap">
    <div class="usecase-heading"><div><p class="eyebrow">{page.applications?.eyebrow ?? 'Where a clear story helps'}</p><h2>{page.applications?.title ?? 'Useful across'}<br /><em>{page.applications?.emphasis ?? 'the whole journey.'}</em></h2></div><p>{page.applications?.body ?? 'One machine can raise different questions at every stage. Give each moment its own focused explanation.'}</p></div>
    <div class="usecase-list">{page.useCases.map((item) => <article class="usecase-row"><span class="usecase-number">{item.number}</span><div class="usecase-title"><span class="tag">{item.tag}</span><h3>{item.title}</h3></div><p>{item.body}</p><span class="row-arrow" aria-hidden="true">↗</span></article>)}</div>
  </div></section>

  <section class="journey-section" id="journey" data-story-step="0">
      <div class="wrap journey-layout">
      <div class="journey-intro"><p class="eyebrow"><span class="eyebrow-dot"></span>{page.journey.eyebrow}</p><h2>{page.journey.title}<br /><em>{page.journey.emphasis}</em></h2><p>{page.journey.body}</p><div class="journey-controls" role="tablist" aria-label={page.journey.navigationLabel ?? 'Follow the workpiece through the machine'}>
        {page.journey.steps.map((step, i) => <button class:list={['journey-tab', i === 0 && 'is-active']} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-story-tab={i} data-story-title={step.title} data-story-copy={step.copy}><span>0{i + 1}</span> {step.tab}</button>)}
      </div></div>
      <div class="journey-visual" aria-live="polite">
        <div class="journey-topline"><span>{page.journey.storyLabel ?? 'ONE WORKPIECE / THREE CLEAR MOMENTS'}</span><span class="journey-counter">01 / 03</span></div>
        <div class="journey-stage">
          {page.journey.steps.map((step, i) => <figure class:list={['journey-scene', i === 0 && 'is-active']} data-story-image={i} aria-hidden={i === 0 ? 'false' : 'true'}>
            <img src={publicAsset(step.image)} alt={step.imageAlt} loading={i === 0 ? 'eager' : 'lazy'} />
            <figcaption><span>0{i + 1} / {step.zone}</span><b>{step.tab}</b></figcaption>
          </figure>)}
          <div class="journey-image-wash" aria-hidden="true"></div>
          <div class="journey-route" aria-hidden="true"><span class="route-line"></span>{page.journey.steps.map((step, i) => <span class:list={['route-stop', i === 0 && 'is-active']} data-route-stop={i}><i></i><b>0{i + 1}</b></span>)}</div>
        </div>
        <div class="journey-caption"><span class="journey-caption-index">01</span><div><h3 data-story-title>{page.journey.steps[0]?.title}</h3><p data-story-copy>{page.journey.steps[0]?.copy}</p></div><span class="journey-next" aria-hidden="true">↗</span></div>
      </div>
    </div>
  </section>

  <section class="comparison-section">
    <div class="wrap comparison-layout">
      <div class="comparison-intro"><p class="eyebrow">A bridge, not a replacement</p><h2>{page.comparison.title}</h2><p>{page.comparison.body}</p></div>
      <div class="comparison-cards">
        <article class="comparison-card"><div class="comparison-label"><span>01</span>{page.comparison.leftTitle}</div><ul>{page.comparison.leftItems.map((item) => <li>{item}</li>)}</ul></article>
        <div class="comparison-plus" aria-hidden="true">+</div>
        <article class="comparison-card comparison-card-story"><div class="comparison-label"><span>02</span>{page.comparison.rightTitle}</div><ul>{page.comparison.rightItems.map((item) => <li>{item}</li>)}</ul></article>
      </div>
      <p class="comparison-note"><span>NOTE / 01</span>{page.comparison.note}</p>
    </div>
  </section>

  <section class="library-section"><div class="wrap library-layout"><div class="library-intro"><p class="eyebrow">Potential next stories</p><h2>{page.library.title}</h2><p>{page.library.body}</p><a class="text-link" href="#contact">Plan your first story <span aria-hidden="true">→</span></a></div><div class="library-items">{page.library.items.map((item, i) => <article class:list={['library-card', `library-card-${i + 1}`]}><div class="library-thumb"><img src={publicAsset(item.poster)} alt={item.alt} loading="lazy" /><span class="library-thumb-index">STORY / {item.number}</span><span class="library-thumb-play" aria-hidden="true">{item.number}</span><span class="library-thumb-line"></span></div><div class="library-card-copy"><span class="library-card-number">{item.number} / STORY DIRECTION</span><h3>{item.title}</h3><p>{item.detail}</p></div><span class="library-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>

  <section class="process-section wrap"><div class="process-heading"><p class="eyebrow">From product to page</p><h2>{page.process.title}</h2></div><div class="process-steps">{page.process.steps.map((step, i) => <article><span class="process-number">{step.number}</span><span class="process-line"></span><h3>{step.title}</h3></article>)}</div></section>

  <section class="faq-section wrap"><div class="faq-intro"><p class="eyebrow">{page.faqTitle?.eyebrow ?? 'Good questions, straight answers'}</p><h2>{page.faqTitle?.title ?? 'Before we make'}<br /><em>{page.faqTitle?.emphasis ?? 'the first frame.'}</em></h2></div><div class="faq-list">{page.faqs.map((faq) => <details><summary>{faq.question}<span aria-hidden="true">＋</span></summary><p>{faq.answer}</p></details>)}</div></section>

  <section class="final-cta" id="contact"><div class="wrap cta-inner"><div class="cta-kicker">DHEE / INDUSTRY STORIES <span>—</span> {page.hero.edition ?? '001'}</div><h2>{page.cta.title}</h2><p>{page.cta.body}</p><div class="hero-actions"><a class="button button-light" href={page.cta.calendar.href} {...ext(page.cta.calendar.href)}>{page.cta.calendar.label}<span aria-hidden="true">↗</span></a><a class="cta-email" href={page.cta.email.href}>{page.cta.email.label}</a></div><span class="cta-orbit" aria-hidden="true">D</span></div></section>
  <script>
    const journey = document.querySelector<HTMLElement>('.journey-section');
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-story-tab]')];
    const title = document.querySelector<HTMLElement>('[data-story-title]');
    const copy = document.querySelector<HTMLElement>('[data-story-copy]');
    const counter = document.querySelector<HTMLElement>('.journey-counter');
    const index = document.querySelector<HTMLElement>('.journey-caption-index');
    const caption = document.querySelector<HTMLElement>('.journey-caption');
    const scenes = [...document.querySelectorAll<HTMLElement>('[data-story-image]')];
    const stops = [...document.querySelectorAll<HTMLElement>('[data-route-stop]')];
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const step = Number(tab.dataset.storyTab);
      journey?.setAttribute('data-story-step', String(step));
      tabs.forEach((item, itemIndex) => {
        const active = itemIndex === step;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      scenes.forEach((scene, sceneIndex) => {
        const active = sceneIndex === step;
        scene.classList.toggle('is-active', active);
        scene.setAttribute('aria-hidden', String(!active));
      });
      stops.forEach((stop, stopIndex) => stop.classList.toggle('is-active', stopIndex === step));
      caption?.classList.add('is-changing');
      window.setTimeout(() => caption?.classList.remove('is-changing'), 140);
      if (title) title.textContent = tab.dataset.storyTitle ?? '';
      if (copy) copy.textContent = tab.dataset.storyCopy ?? '';
      if (counter) counter.textContent = `0${step + 1} / 03`;
      if (index) index.textContent = `0${step + 1}`;
    }));
    const reply = document.querySelector<HTMLElement>('.reply-section');
    const replyTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-reply-tab]')];
    const replyQuestion = document.querySelector<HTMLElement>('.chat-question');
    const replyAnswer = document.querySelector<HTMLElement>('.chat-answer');
    const replyAsset = document.querySelector<HTMLElement>('.reply-asset [data-reply-asset]');
    replyTabs.forEach((tab) => tab.addEventListener('click', () => {
      const step = Number(tab.dataset.replyTab);
      if (!tab.dataset.replyQuestion || !tab.dataset.replyAnswer || !tab.dataset.replyAsset) return;
      reply?.setAttribute('data-reply-step', String(step));
      replyTabs.forEach((item, itemIndex) => {
        const active = itemIndex === step;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-selected', String(active));
      });
      if (replyQuestion) replyQuestion.textContent = tab.dataset.replyQuestion;
      if (replyAnswer) replyAnswer.textContent = tab.dataset.replyAnswer;
      if (replyAsset) replyAsset.textContent = tab.dataset.replyAsset;
    }));
    const revealItems = document.querySelectorAll<HTMLElement>('.hero-copy, .hero-art, .principle-copy, .journey-layout, .reply-layout, .usecase-row, .sample-heading, .sample-frame, .comparison-layout, .library-layout, .process-steps, .faq-section, .final-cta .cta-inner');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      revealItems.forEach((item) => item.classList.add('motion-ready'));
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }), { threshold: 0.14 });
      revealItems.forEach((item) => observer.observe(item));
    }
    const scrollVideos = [...document.querySelectorAll<HTMLVideoElement>('video[data-scroll-autoplay]')];
    const attemptSoundOnPlayback = (video: HTMLVideoElement) => {
      const startButton = video.parentElement?.querySelector<HTMLButtonElement>('.video-sound-start');
      void video.play().then(() => { if (startButton) startButton.hidden = true; }).catch(() => { if (startButton) startButton.hidden = false; });
    };
    scrollVideos.forEach((video) => {
      const startButton = video.parentElement?.querySelector<HTMLButtonElement>('.video-sound-start');
      if (!startButton) return;
      const showSoundStart = () => { startButton.hidden = false; };
      const hideSoundStart = () => { startButton.hidden = true; };
      video.addEventListener('play', hideSoundStart);
      startButton.addEventListener('click', () => {
        video.muted = false;
        void video.play().then(hideSoundStart).catch(showSoundStart);
      });
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) showSoundStart();
    });
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const videoObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          attemptSoundOnPlayback(video);
        }
        else video.pause();
      }), { threshold: 0.35 });
      scrollVideos.forEach((video) => videoObserver.observe(video));
    }
    const updateActiveLink = () => {
      const sections = ['first-response', 'applications', 'journey', 'sample'].map((id) => document.getElementById(id)).filter((section): section is HTMLElement => Boolean(section));
      const current = sections.filter((section) => section.getBoundingClientRect().top < window.innerHeight * 0.42).at(-1);
      document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a').forEach((link) => {
        const active = current?.id === link.hash.slice(1);
        link.classList.toggle('is-current', Boolean(active));
      });
    };
    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
    document.querySelectorAll<HTMLAnchorElement>('.mobile-nav nav a').forEach((link) => link.addEventListener('click', () => {
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      if (menu) menu.open = false;
    }));
  </script>
</LandingPage>
