---
import LandingPage from '../layouts/LandingPage.astro';
import StudioHero from '../components/StudioHero.astro';
import KineticMarquee from '../components/KineticMarquee.astro';
import ConceptBridge from '../components/ConceptBridge.astro';
import AccountShowcaseBands from '../components/AccountShowcaseBands.astro';
import TriggerAndMetrics from '../components/TriggerAndMetrics.astro';
import FirstResponseStudio from '../components/FirstResponseStudio.astro';
import UseCasesGrid from '../components/UseCasesGrid.astro';
import InteractiveJourney from '../components/InteractiveJourney.astro';
import ComparisonSection from '../components/ComparisonSection.astro';
import StoryLibrary from '../components/StoryLibrary.astro';
import ProcessStack from '../components/ProcessStack.astro';
import FaqSection from '../components/FaqSection.astro';
import ClosingCta from '../components/ClosingCta.astro';
import type { LandingPage as PageData } from '../content/schema';
import { validateLandingPage } from '../content/schema';

type LocaleFile = {
  language: string;
  label: string;
  slug: string;
  captionsUrl?: string;
  translations: Record<string, string>;
  reviewStatus: 'draft-machine-translation' | 'human-reviewed';
};

export function getStaticPaths() {
  function translateConfig(value: unknown, dictionary: Record<string, string>): unknown {
    if (typeof value === 'string') return dictionary[value] ?? value;
    if (Array.isArray(value)) return value.map((item) => translateConfig(item, dictionary));
    if (value && typeof value === 'object') {
      return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, translateConfig(item, dictionary)]));
    }
    return value;
  }

  const pageModules = import.meta.glob('../content/pages/*.json', { eager: true, import: 'default' });
  const localeModules = import.meta.glob('../content/locales/*.json', { eager: true, import: 'default' });

  const localesByBaseSlug = new Map<string, LocaleFile[]>();
  for (const [filePath, rawLocale] of Object.entries(localeModules)) {
    const filename = filePath.split('/').pop() ?? '';
    const match = filename.match(/^([a-z0-9-]+)\.[a-z]{2}\.json$/);
    if (!match) continue;
    const baseSlug = match[1];
    const list = localesByBaseSlug.get(baseSlug) ?? [];
    list.push(rawLocale as LocaleFile);
    localesByBaseSlug.set(baseSlug, list);
  }

  const basePages = Object.values(pageModules) as PageData[];
  const pages: PageData[] = [];

  for (const basePage of basePages) {
    const localeConfigs = localesByBaseSlug.get(basePage.slug);
    if (!localeConfigs || localeConfigs.length === 0) {
      pages.push(basePage);
      continue;
    }

    localeConfigs.sort((a, b) => a.language.localeCompare(b.language));
    const variants = [
      { language: basePage.language, label: basePage.language.toUpperCase(), slug: basePage.slug },
      ...localeConfigs.map(({ language, label, slug }) => ({ language, label, slug }))
    ];

    pages.push({ ...basePage, languageVariants: variants, languageLabel: 'Language' });

    for (const locale of localeConfigs) {
      const translated = translateConfig(basePage, locale.translations) as PageData;
      translated.slug = locale.slug;
      translated.language = locale.language;
      if (locale.captionsUrl) translated.video.captionsUrl = locale.captionsUrl;
      translated.languageVariants = variants;
      translated.languageLabel = locale.translations.Language ?? 'Language';
      translated.localeReview = locale.reviewStatus;
      pages.push(translated);
    }
  }

  for (const page of pages) validateLandingPage(page);
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: PageData };

const envVideoOverride =
  page.presentation?.videoEnvOverride === 'PUBLIC_MULTIPLY_LABS_VIDEO_URL'
    ? import.meta.env.PUBLIC_MULTIPLY_LABS_VIDEO_URL
    : undefined;
const configuredVideoUrl = envVideoOverride || page.video.videoUrl;

const marqueeItems = page.marqueeItems ?? [
  ...page.concept.steps,
  ...page.useCases.map((u) => u.tag),
  'Reviewed claims & captions',
  'Managed studio production'
];
---
<LandingPage page={page}>
  <StudioHero page={page} configuredVideoUrl={configuredVideoUrl} />
  <KineticMarquee items={marqueeItems} />
  <ConceptBridge page={page} />
  <AccountShowcaseBands page={page} configuredVideoUrl={configuredVideoUrl} />
  <TriggerAndMetrics page={page} />
  <FirstResponseStudio page={page} />
  <UseCasesGrid page={page} />
  <InteractiveJourney page={page} />
  <ComparisonSection page={page} />
  <StoryLibrary page={page} />
  <ProcessStack page={page} />
  <FaqSection page={page} />
  <ClosingCta page={page} />
</LandingPage>
