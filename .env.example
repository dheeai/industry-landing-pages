# Optional. Set this only after DHEE approves the public privacy notice.
PUBLIC_PRIVACY_URL=

# Optional. Plausible loads only after a visitor accepts analytics and both
# this setting and PUBLIC_PRIVACY_URL are present.
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional. Direct browser-playable URL from the approved streaming host.
# Leave unset to use the local MP4 for development and review.
PUBLIC_MULTIPLY_LABS_VIDEO_URL=
